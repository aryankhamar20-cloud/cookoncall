# Security headers apply to every path.
#
# Cache-Control on this catch-all rule (docs/30 A6): this is a fully static
# export where every page is rebuilt on each deploy (new asset hashes for
# its JS/CSS), so it's safe to let the CDN edge-cache the HTML instead of
# treating it as dynamic — previously this served `cf-cache-status: DYNAMIC`
# with max-age=0 on every page, so every visit revalidated at origin instead
# of being served from the edge. Applied here on the catch-all `/*` rule, not
# a `/*.html` glob, because Cloudflare Pages matches against the request
# path (e.g. `/about`), not the underlying file it maps to (`about.html`) —
# `trailingSlash`/`cleanUrls` aren't set to keep `.html` in the URL. A short
# max-age plus must-revalidate keeps a stale page from surviving more than a
# minute past a fresh deploy while still letting Cloudflare serve
# repeat/nearby visitors from edge cache instead of origin every time.
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=(self "https://checkout.razorpay.com" "https://api.razorpay.com")
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; base-uri 'self'; frame-ancestors 'none'; object-src 'none'; script-src 'self' 'unsafe-inline' https://accounts.google.com https://*.razorpay.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https://res.cloudinary.com https://*.railway.app; connect-src 'self' https://*.railway.app wss://*.railway.app https://accounts.google.com https://*.razorpay.com https://*.sentry.io https://*.ingest.sentry.io; frame-src https://*.razorpay.com https://accounts.google.com; form-action 'self'; upgrade-insecure-requests
  Cache-Control: public, max-age=60, must-revalidate

# Next.js static export content-hashes every file under _next/static — safe
# to cache immutably for a year, standard Next.js convention. More specific
# than the `/*` rule above, so this Cache-Control wins for these paths.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
